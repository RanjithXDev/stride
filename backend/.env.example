# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/stride

# ── Auth ─────────────────────────────────────────────────────
# JWT signing secret — minimum 32 chars, keep secret
JWT_SECRET=change_me_to_a_long_random_secret_minimum_32_chars

# ── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── CORS / Frontend URL ───────────────────────────────────────
# The URL of the deployed frontend (used for CORS + password reset links)
FRONTEND_URL=https://your-stride-app.up.railway.app

# ── Encryption ───────────────────────────────────────────────
# AES-256-GCM key for encrypting stored OAuth/PM tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=64_hex_chars_here

# ── File Uploads ──────────────────────────────────────────────
# Max file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# ── Optional: SCM OAuth credentials ──────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
